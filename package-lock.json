      }
    },
    "providers/engine-unity": {
      "name": "@toolimport/provider-engine-unity",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@toolimport/utool-core": "*"
      },
      "engines": {
        "node": ">=20.11"
      }
