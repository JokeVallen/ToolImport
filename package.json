{
  "name": "toolimport",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Engine-agnostic backend for the ToolRegistry import tool: parses the .yaml format, resolves dependencies, verifies and installs sealed artifacts, and records receipts. Runs entirely outside Unity.",
  "license": "MIT",
  "author": "DevCat",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "providers/*",
    "apps/*",
    "frontends/*"
  ],
  "scripts": {
    "test": "node tools/check-tracked.mjs && node --test \"packages/utool-core/test/*.test.js\" \"apps/cli/test/*.test.js\"",
    "check:csharp": "node tools/csharp-check.mjs",
    "check:godot": "node tools/godot-check.mjs",
    "check:tracked": "node tools/check-tracked.mjs",
    "cli": "node apps/cli/bin/utool.js",
    "validate": "node apps/cli/bin/utool.js validate ../ToolRegistry"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  }
}
